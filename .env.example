# SwiftPost — environment variable template
# Copy the relevant file to .env (backend) or .env.local (frontend) and fill in values.
# Never commit real secrets. This file contains NAMES and safe PLACEHOLDERS only.
#
# Backend:  copy this to  blogging-system-yt/.env
# Frontend: copy NEXT_PUBLIC_* lines to source/.env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (Django) — blogging-system-yt/.env
# -----------------------------------------------------------------------------

DJANGO_ENV=dev
# DJANGO_SECRET_KEY=change-me-in-production   # required in prod; generate with `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend origin(s), comma-separated. Used for CORS / CSRF trusted origins.
FRONTEND_ORIGIN=http://localhost:3000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Leave empty for local SQLite. Production REQUIRES a PostgreSQL URL.
DATABASE_URL=

# Redis / Celery — V2 only; not required for V1 local development.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Media storage: local (dev) or s3 (production)
MEDIA_STORAGE=local
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_EDGE=4000

# AWS / S3-compatible storage (production only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=
AWS_S3_PUBLIC_BASE_URL=

# AI provider (AICredits-compatible OpenAI-compatible endpoint)
AI_PROVIDER=openai_compatible
AI_MODEL=openai/gpt-5.4-mini
AI_MODEL_COMPOSE=nvidia/nemotron-3-super-120b-a12b
AI_MODEL_REVIEW=openai/gpt-5.5
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.aicredits.in/v1

# Search provider (Tavily) — live image suggestions in V1
SEARCH_PROVIDER=tavily
TAVILY_MAX_RESULTS=5
TAVILY_TEST_BUDGET=12
TAVILY_API_KEY=

# -----------------------------------------------------------------------------
# Frontend (Next.js) — source/.env.local
# -----------------------------------------------------------------------------
# Only NEXT_PUBLIC_* variables are exposed to the browser. Never put secrets here.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL=  # empty in dev (uses Next.js proxy to Django :8000)
