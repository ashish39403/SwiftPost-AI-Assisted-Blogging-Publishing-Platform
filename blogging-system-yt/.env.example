# Copy to .env for local development. Never commit .env.
DJANGO_ENV=dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Next.js origin. Comma-separate extra origins if needed.
FRONTEND_ORIGIN=http://localhost:3000
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Leave empty for local SQLite. Production requires a PostgreSQL URL.
DATABASE_URL=

# Used in later slices. Not read by the foundation health check.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
MEDIA_STORAGE=local
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_EDGE=4000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_ENDPOINT_URL=
AWS_S3_PUBLIC_BASE_URL=
AI_PROVIDER=openai_compatible
# Fallback if a task-specific model is empty. AICredits IDs work as provider/name.
AI_MODEL=openai/gpt-5.4-mini
# Composer: full private blog from a title.
AI_MODEL_COMPOSE=nvidia/nemotron-3-super-120b-a12b
# Anna: draft review notes.
AI_MODEL_REVIEW=openai/gpt-5.5
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=https://api.aicredits.in/v1
SEARCH_PROVIDER=tavily
TAVILY_MAX_RESULTS=5
TAVILY_TEST_BUDGET=12
TAVILY_API_KEY=
