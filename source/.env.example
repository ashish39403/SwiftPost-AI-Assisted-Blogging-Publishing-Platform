# Copy to .env.local for local development. Never commit .env.local.
# Only NEXT_PUBLIC_* variables are exposed to the browser. Never put secrets here.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Empty in local dev: the Next.js rewrite proxies /api and /media to Django on 127.0.0.1:8000.
NEXT_PUBLIC_API_URL=
